# API 호출 인증 토큰 (X-API-Key 헤더). 비우면 인증 비활성 (로컬 개발용)
SERVICE_API_KEY=

# 1단계: GitHub Code Search API 인증 토큰 (stage=github 시 필수)
GITHUB_TOKEN=

# 2단계: 웹 검색 공급자 (brave | google_cse | serpapi)
WEB_SEARCH_PROVIDER=brave
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SERPAPI_KEY=

# 실행 튜닝
MAX_CONCURRENT_JOBS=4
MAX_CONCURRENT_FETCHES=8
FETCH_TIMEOUT_S=10
HTTP_USER_AGENT=whereismykey/0.1 (+security-scan)
DEFAULT_MAX_RESULTS_PER_SOURCE=50
