# ==========================================
# whereismykey 환경변수 설정 예시
# ==========================================

# 1. API 자체 인증 (권장, 미설정 시 로컬 개발용으로 인증 비활성화)
# SERVICE_API_KEY=your-secret-api-key

# 2. 1단계: GitHub Code Search (stage=github 시 필수)
# GitHub Personal Access Token (classic: repo or read:packages, 또는 fine-grained token)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 3. 2단계: 웹 검색 공급자 설정
# 지원 옵션: brave (기본) | google_cse | serpapi
WEB_SEARCH_PROVIDER=brave

# Brave Search API (provider=brave 시 필수)
# BRAVE_API_KEY=BSAxxyyzz...

# Google CSE (provider=google_cse 시 필수)
# GOOGLE_CSE_KEY=AIzaSy...
# GOOGLE_CSE_CX=0123456789...

# SerpAPI (provider=serpapi 시 필수)
# SERPAPI_KEY=xxxxxxxx...

# 4. 성능 및 동시성 튜닝
MAX_CONCURRENT_JOBS=4
MAX_CONCURRENT_FETCHES=8
FETCH_TIMEOUT_S=10.0
HTTP_USER_AGENT=whereismykey/0.1 (+security-scan)
DEFAULT_MAX_RESULTS_PER_SOURCE=50
